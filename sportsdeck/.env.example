DATABASE_URL="postgresql://postgres:password@localhost:5432/sportsdeck"

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Hugging face token
HF_TOKEN=

# football api
FOOTBALL_API_KEY=

# Gemini api key
GEMINI_KEY=


# Oauth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000/api/nextauth
